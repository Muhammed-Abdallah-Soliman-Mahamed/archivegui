[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/gzip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;
Actions=extractHere;
X-KDE-Priority=TopLevel

[Desktop Action extractHere]
Name=Extract Here (ArchiveGui)
Name[ar]=استخراج هنا (ArchiveGui)
Icon=archive-extract
Exec=bash /usr/lib/archivegui/scripts/archivegui-extract-here.sh %F
